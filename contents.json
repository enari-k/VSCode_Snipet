		"2D Bin Packing Node": {
			"prefix": "BinPackingNode",
			"body": [
				"using System;",
				"using System.Collections.Generic;",
				"using System.Drawing; // Unityの場合は RectInt 等に変更してください",
				"",
				"/*",
				" * [使い方の例]",
				" * // 1. コンテナ(ルートノード)を作成 (例: 1024x1024)",
				" * var root = new PackingNode(new Rectangle(0, 0, 1024, 1024));",
				" * ",
				" * // 2. 詰め込みたい矩形リストを準備",
				" * var items = new List<Size> { new Size(100, 100), new Size(50, 200), ... };",
				" * ",
				" * // 【重要】大きい順にソートすると隙間が減り、成功率が上がります",
				" * items.Sort((a, b) => (b.Width * b.Height).CompareTo(a.Width * a.Height));",
				" * ",
				" * // 3. 順番に挿入",
				" * foreach (var size in items)",
				" * {",
				" * var node = root.Insert(size);",
				" * if (node != null)",
				" * {",
				" * Console.WriteLine($\"配置成功: {node.Bounds}\");",
				" * }",
				" * else",
				" * {",
				" * Console.WriteLine(\"配置失敗: 空き領域不足\");",
				" * }",
				" * }",
				" */",
				"",
				"public class PackingNode",
				"{",
				"    public Rectangle Bounds { get; set; }",
				"    public PackingNode[] Children { get; private set; }",
				"    public bool IsOccupied { get; set; }",
				"",
				"    public PackingNode(Rectangle bounds)",
				"    {",
				"        Bounds = bounds;",
				"        Children = null;",
				"        IsOccupied = false;",
				"    }",
				"",
				"    public PackingNode Insert(Size size)",
				"    {",
				"        // 1. すでに子ノードがある場合は、子ノードへ再帰的に依頼",
				"        if (Children != null)",
				"        {",
				"            var node = Children[0].Insert(size);",
				"            return node ?? Children[1].Insert(size);",
				"        }",
				"",
				"        // 2. すでに使用中、またはサイズが足りない場合は不可",
				"        if (IsOccupied || size.Width > Bounds.Width || size.Height > Bounds.Height)",
				"        {",
				"            return null;",
				"        }",
				"",
				"        // 3. サイズがぴったりな場合は、ここを使用中にする",
				"        if (size.Width == Bounds.Width && size.Height == Bounds.Height)",
				"        {",
				"            IsOccupied = true;",
				"            return this;",
				"        }",
				"",
				"        // 4. 残りの領域を分割して子ノードを作成",
				"        Children = new PackingNode[2];",
				"",
				"        int deltaW = Bounds.Width - size.Width;",
				"        int deltaH = Bounds.Height - size.Height;",
				"",
				"        // どちらの方向に分割するかを決定（より大きく余る方を分割）",
				"        if (deltaW > deltaH)",
				"        {",
				"            // 垂直分割 (右側に余りを作る)",
				"            Children[0] = new PackingNode(new Rectangle(Bounds.X, Bounds.Y, size.Width, Bounds.Height));",
				"            Children[1] = new PackingNode(new Rectangle(Bounds.X + size.Width, Bounds.Y, deltaW, Bounds.Height));",
				"        }",
				"        else",
				"        {",
				"            // 水平分割 (下側に余りを作る)",
				"            Children[0] = new PackingNode(new Rectangle(Bounds.X, Bounds.Y, Bounds.Width, size.Height));",
				"            Children[1] = new PackingNode(new Rectangle(Bounds.X, Bounds.Y + size.Height, Bounds.Width, deltaH));",
				"        }",
				"",
				"        // 分割した直後の最初の子ノードに挿入（再帰によりもう一方の軸も分割される）",
				"        return Children[0].Insert(size);",
				"    }",
				"}"
