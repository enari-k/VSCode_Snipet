	"BFS (Grid)": {
		"prefix": "bfsgrid",
		"body": [
			"int[] dx = { 0, 1, 0, -1 };",
			"int[] dy = { -1, 0, 1, 0 };",
			"var dist = new int[${1:H}, ${2:W}];",
			"for (int i = 0; i < ${1:H}; i++)",
			"    for (int j = 0; j < ${2:W}; j++)",
			"        dist[i, j] = -1;",
			"",
			"var queue = new Queue<(int, int)>();",
			"dist[${3:sy}, ${4:sx}] = 0;",
			"queue.Enqueue((${3:sy}, ${4:sx}));",
			"",
			"while (queue.Count > 0)",
			"{",
			"    var (y, x) = queue.Dequeue();",
			"",
			"    for (int i = 0; i < 4; i++)",
			"    {",
			"        int ny = y + dy[i];",
			"        int nx = x + dx[i];",
			"",
			"        if (ny < 0 || nx < 0 || ny >= ${1:H} || nx >= ${2:W}) continue;",
			"        if (${5:S}[ny][nx] == '#') continue;",
			"        if (dist[ny, nx] != -1) continue;",
			"",
			"        dist[ny, nx] = dist[y, x] + 1;",
			"        queue.Enqueue((ny, nx));",
			"    }",
			"}"
		],
		"description": "グリッド上の幅優先探索 (迷路)"
	},
	"Dijkstra (PriorityQueue)": {
		"prefix": "dijkstra",
		"body": [
			"// 距離配列の初期化 (無限大)",
			"long[] dist = new long[${1:N} + 1];",
			"Array.Fill(dist, long.MaxValue);",
			"",
			"// PriorityQueue<頂点, 距離> (距離が小さい順に取り出す)",
			"var pq = new PriorityQueue<int, long>();",
			"",
			"// スタート地点の設定",
			"dist[${2:startNode}] = 0;",
			"pq.Enqueue(${2:startNode}, 0);",
			"",
			"while (pq.Count > 0)",
			"{",
			"    // 最短距離候補を取り出す",
			"    pq.TryDequeue(out int u, out long d);",
			"",
			"    // 既に記録されている距離より長ければスキップ (高速化の肝)",
			"    if (d > dist[u]) continue;",
			"",
			"    // 隣接頂点を探索 (G[u] は (行き先v, コストcost) のリスト想定)",
			"    foreach (var (v, cost) in ${3:G}[u])",
			"    {",
			"        if (dist[v] > dist[u] + cost)",
			"        {",
			"            dist[v] = dist[u] + cost;",
			"            pq.Enqueue(v, dist[v]);",
			"        }",
			"    }",
			"}"
		],
		"description": "ダイクストラ法 (重み付き最短経路)"
	},

	"Warshall-Floyd": {
		"prefix": "wf",
		"body": [
			"// k: 経由点, i: 始点, j: 終点",
			"// dist[i, j] は初期化済み (辺がないところは INF) とする",
			"for (int k = 0; k < ${1:N}; k++)",
			"{",
			"    for (int i = 0; i < ${1:N}; i++)",
			"    {",
			"        for (int j = 0; j < ${1:N}; j++)",
			"        {",
			"            if (${2:dist}[i, k] != ${3:INF} && ${2:dist}[k, j] != ${3:INF})",
			"            {",
			"                ${2:dist}[i, j] = Math.Min(${2:dist}[i, j], ${2:dist}[i, k] + ${2:dist}[k, j]);",
			"            }",
			"        }",
			"    }",
			"}"
		],
		"description": "ワーシャル・フロイド法 (全点対最短経路 O(N^3))"
	},
  	"ModularCombinationwithUsage": {
    	"prefix": "ncr_mod",
    	"body": [
      	"/**",
      	" * 【使い方】",
      	" * var comb = new Combination(最大値N, 法MOD);",
      	" * long result = comb.nCr(n, r);",
      	" */",
    	"public class Combination",
      	"{",
      	"    private readonly long[] _fact;     // 階乗: n!",
      	"    private readonly long[] _inv;      // 逆元: n^-1",
      	"    private readonly long[] _factInv;  // 階乗の逆元: (n!)^-1",
      	"    private readonly long _mod;",
      	"",
      	"    /// <param name=\"max\">計算する可能性のある最大値 (N <= 2*10^5 など)</param>",
      	"    /// <param name=\"mod\">法 (998244353 や 1000000007 など)</param>",
      	"    public Combination(int max, long mod)",
      	"    {",
      	"        _mod = mod;",
      	"        _fact = new long[max + 1];",
      	"        _inv = new long[max + 1];",
      	"        _factInv = new long[max + 1];",
      	"",
      	"        _fact[0] = _fact[1] = 1;",
      	"        _factInv[0] = _factInv[1] = 1;",
      	"        _inv[1] = 1;",
      	"",
      	"        for (int i = 2; i <= max; i++)",
      	"        {",
      	"            // 階乗の計算",
      	"            _fact[i] = _fact[i - 1] * i % _mod;",
      	"            // 逆元の計算 (O(N)の動的計画法による一括計算)",
      	"            _inv[i] = _mod - _inv[_mod % i] * (_mod / i) % _mod;",
      	"            // 階乗の逆元の計算",
      	"            _factInv[i] = _factInv[i - 1] * _inv[i] % _mod;",
      	"        }",
      	"    }",
      	"",
      	"    /// <summary>nCr (組み合わせ) を計算します</summary>",
      	"    public long nCr(int n, int r)",
      	"    {",
      	"        if (n < r || n < 0 || r < 0) return 0;",
      	"        // 公式: n! / (r! * (n-r)!)",
      	"        return _fact[n] * (_factInv[r] * _factInv[n - r] % _mod) % _mod;",
      	"    }",
      	"",
      	"    /// <summary>nPr (順列) を計算します</summary>",
      	"    public long nPr(int n, int r)",
      	"    {",
      	"        if (n < r || n < 0 || r < 0) return 0;",
      	"        // 公式: n! / (n-r)!",
      	"        return _fact[n] * _factInv[n - r] % _mod;",
      	"    }",
      	"",
      	"    /// <summary>nHr (重複組み合わせ) を計算します</summary>",
      	"    public long nHr(int n, int r)",
      	"    {",
      	"        if (n == 0 && r == 0) return 1;",
      	"        // 公式: (n+r-1)Cr",
      	"        return nCr(n + r - 1, r);",
      	"    }",
      	"}"
    	],
    	"description": "Modular Combination (nCr, nPr, nHr) with O(N) preprocessing."
  	},
		"Strongly Connected Components (Kosaraju)": {
			"prefix": "scc",
			"body": [
				"/// <summary>",
				"/// 強連結成分分解 (Kosaraju's Algorithm)",
				"/// Usage:",
				"/// 1. var scc = new SCC(n);          // 頂点数nで初期化",
				"/// 2. scc.AddEdge(u, v);             // 辺を追加 (0-indexed)",
				"/// 3. scc.Build();                   // 構築",
				"/// 4. var groups = scc.Components;   // 結果取得 (List<List<int>>)",
				"/// </summary>",
				"public class SCC",
				"{",
				"    public int N { get; private set; }",
				"    public List<List<int>> Components { get; private set; }",
				"    private List<int>[] _g;",
				"    private List<int>[] _rg;",
				"    private List<int> _order;",
				"    private bool[] _visited;",
				"",
				"    public SCC(int n)",
				"    {",
				"        N = n;",
				"        _g = new List<int>[n];",
				"        _rg = new List<int>[n];",
				"        for (int i = 0; i < n; i++)",
				"        {",
				"            _g[i] = new List<int>();",
				"            _rg[i] = new List<int>();",
				"        }",
				"    }",
				"",
				"    public void AddEdge(int u, int v)",
				"    {",
				"        _g[u].Add(v);",
				"        _rg[v].Add(u);",
				"    }",
				"",
				"    public void Build()",
				"    {",
				"        _order = new List<int>();",
				"        _visited = new bool[N];",
				"        Components = new List<List<int>>();",
				"",
				"        for (int i = 0; i < N; i++) if (!_visited[i]) Dfs1(i);",
				"",
				"        Array.Fill(_visited, false);",
				"        for (int i = _order.Count - 1; i >= 0; i--)",
				"        {",
				"            int u = _order[i];",
				"            if (!_visited[u])",
				"            {",
				"                var component = new List<int>();",
				"                Dfs2(u, component);",
				"                Components.Add(component);",
				"            }",
				"        }",
				"    }",
				"",
				"    private void Dfs1(int u)",
				"    {",
				"        _visited[u] = true;",
				"        foreach (var v in _g[u]) if (!_visited[v]) Dfs1(v);",
				"        _order.Add(u);",
				"    }",
				"",
				"    private void Dfs2(int u, List<int> component)",
				"    {",
				"        _visited[u] = true;",
				"        component.Add(u);",
				"        foreach (var v in _rg[u]) if (!_visited[v]) Dfs2(v, component);",
				"    }",
				"}"
