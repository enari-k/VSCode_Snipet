	"BFS (Graph)": {
		"prefix": "bfs",
		"body": [
			"// 距離配列の初期化 (-1)",
			"var dist = new int[${1:N} + 1];",
			"Array.Fill(dist, -1);",
			"",
			"var queue = new Queue<int>();",
			"dist[${2:startNode}] = 0;",
			"queue.Enqueue(${2:startNode});",
			"",
			"while (queue.Count > 0)",
			"{",
			"    var u = queue.Dequeue();",
			"",
			"    foreach (var v in ${3:G}[u])",
			"    {",
			"        if (dist[v] == -1)",
			"        {",
			"            dist[v] = dist[u] + 1;",
			"            queue.Enqueue(v);",
			"        }",
			"    }",
			"}"
		],
		"description": "幅優先探索 (最短経路)"
	},

	"DFS (Recursive)": {
		"prefix": "dfs",
		"body": [
			"var visited = new bool[${1:N} + 1];",
			"",
			"void Dfs(int u)",
			"{",
			"    visited[u] = true;",
			"    // 行きがけの処理",
			"",
			"    foreach (var v in ${2:G}[u])",
			"    {",
			"        if (!visited[v])",
			"        {",
			"            Dfs(v);",
			"        }",
			"    }",
			"    // 帰りがけの処理",
			"}",
			"",
			"Dfs(${3:startNode});"
