{
	"AtCoder Template with FastIO": {
		"prefix": "atcoder",
		"body": [
			"// https://github.com/enari-k/VSCode_Snipet",
			"using System;",
			"using System.Collections.Generic;",
			"using System.Linq;",
			"using System.Text;",
			"using System.IO;",
			"using AtCoder;",
			"",
			"class Program",
			"{",
			"    static void Main()",
			"    {",
			"        var sc = new FastScanner();",
			"        var sw = new StreamWriter(Console.OpenStandardOutput()) { AutoFlush = false };",
			"        Console.SetOut(sw);",
			"        $0",
			"        Console.Out.Flush();",
			"    }",
			"",
			"    static int LowerBound(List<long> list, long value)",
			"    {",
			"        int left = 0, right = list.Count;",
			"        while (left < right)",
			"        {",
			"            int mid = left + (right - left) / 2;",
			"            if (list[mid] < value) left = mid + 1;",
			"            else right = mid;",
			"        }",
			"        return left;",
			"    }",
			"",
			"    static int UpperBound(List<long> list, long value)",
			"    {",
			"        int left = 0, right = list.Count;",
			"        while (left < right)",
			"        {",
			"            int mid = left + (right - left) / 2;",
			"            if (list[mid] <= value) left = mid + 1;",
			"            else right = mid;",
			"        }",
			"        return left;",
			"    }",
			"    static void D(object o)",
			"    {",
			"    #if DEBUG",
			"        Console.WriteLine(o);",
			"    #endif",
			"    }",
			"}",
			"",
			"class FastScanner",
			"{",
			"    private readonly Stream _stream;",
			"    private readonly byte[] _buffer = new byte[1024];",
			"    private int _ptr = 0;",
			"    private int _buflen = 0;",
			"",
			"    public FastScanner() { _stream = Console.OpenStandardInput(); }",
			"",
			"    private bool HasNextByte()",
			"    {",
			"        if (_ptr < _buflen) return true;",
			"        _ptr = 0;",
			"        _buflen = _stream.Read(_buffer, 0, _buffer.Length);",
			"        return _buflen > 0;",
			"    }",
			"",
			"    private byte ReadByte() => HasNextByte() ? _buffer[_ptr++] : (byte)0;",
			"",
			"    private static bool IsPrintableChar(int c) => 33 <= c && c <= 126;",
			"",
			"    private void SkipUnprintable()",
			"    {",
			"        while (HasNextByte() && !IsPrintableChar(_buffer[_ptr])) _ptr++;",
			"    }",
			"",
			"    public string Str()",
			"    {",
			"        SkipUnprintable();",
			"        var sb = new StringBuilder();",
			"        while (HasNextByte() && IsPrintableChar(_buffer[_ptr]))",
			"        {",
			"            sb.Append((char)ReadByte());",
			"        }",
			"        return sb.ToString();",
			"    }",
			"",
			"    public int Int()",
			"    {",
			"        long n = Long();",
			"        if (n < int.MinValue || n > int.MaxValue) throw new OverflowException();",
			"        return (int)n;",
			"    }",
			"",
			"    public long Long()",
			"    {",
			"        SkipUnprintable();",
			"        long n = 0;",
			"        bool minus = false;",
			"        byte b = ReadByte();",
			"        if (b == '-') { minus = true; b = ReadByte(); }",
			"        if (b < '0' || '9' < b) throw new FormatException();",
			"        while (true)",
			"        {",
			"            if ('0' <= b && b <= '9') { n *= 10; n += b - '0'; }",
			"            else if (b == (byte)0 || !IsPrintableChar(b)) return minus ? -n : n;",
			"            else throw new FormatException();",
			"            b = ReadByte();",
			"        }",
			"    }",
			"",
			"    public double Double() => double.Parse(Str());",
			"    public int[] IntArr(int n) { var a = new int[n]; for (int i = 0; i < n; i++) a[i] = Int(); return a; }",
			"    public long[] LongArr(int n) { var a = new long[n]; for (int i = 0; i < n; i++) a[i] = Long(); return a; }",
			"}"
		],
			"description": "AtCoder完全高速化テンプレート(FastScanner/StreamWriter)"
	},
    "ACL LazySegtree (Struct Definition with Comments)": {
        "prefix": "acl_lazy_struct_detailed",
        "body": [
            "// ★ Mainメソッドの外(class Programの中など)に貼り付けてください",
            "struct ${1:MyOp} : ILazySegtreeOperator<${2:long}, ${3:long}>",
            "{",
            "\t// --------------------------------------",
            "\t// ■ S: データ (${2:long}) 側の定義",
            "\t// --------------------------------------",
            "",
            "\t// 1. Operate (データの合成)",
            "\t//    役割: 2つの子ノードの値(x, y)から、親ノードの値を作る。",
            "\t//    タイミング: 更新や取得時、下から上へ値を計算するとき。",
            "\t//    例: 区間最大値なら Math.Max(x, y)、区間和なら x + y",
            "\tpublic ${2:long} Operate(${2:long} x, ${2:long} y) => Math.${4:Max}(x, y);",
            "",
            "\t// 2. Identity (データの単位元)",
            "\t//    役割: 範囲外や初期状態のときの値。Operateしても結果が変わらない値。",
            "\t//    例: Maxなら long.MinValue, Minなら long.MaxValue, 和なら 0",
            "\tpublic ${2:long} Identity => ${5:long.MinValue};",
            "",
            "\t// --------------------------------------",
            "\t// ■ F: 作用素 (${3:long}) 側の定義 (遅延させる操作)",
            "\t// --------------------------------------",
            "",
            "\t// 3. Mapping (操作の適用: F -> S)",
            "\t//    役割: データ x に対して、操作 f を適用した結果を返す。",
            "\t//    タイミング: 遅延配列から実際のデータ配列に値を反映(伝播)するとき。",
            "\t//    例(更新): f が -1(無効値) でなければ x を f に書き換える",
            "\t//    例(加算): x + f (※区間和の場合は (x + f * 幅) になる点に注意)",
            "\tpublic ${2:long} Mapping(${3:long} f, ${2:long} x) => ${6:(f == -1 ? x : f)};",
            "",
            "\t// 4. Composition (操作の合成: F x F -> F)",
            "\t//    役割: すでに溜まっている操作 g の上に、新しい操作 f を追加する。",
            "\t//    注意: 引数の順序は (新, 旧) です。数学的には f ∘ g。",
            "\t//    例(更新): f が有効なら g を上書きする (f == -1 ? g : f)",
            "\t//    例(加算): f + g (今までの加算分 g に、さらに f を足す)",
            "\tpublic ${3:long} Composition(${3:long} f, ${3:long} g) => ${7:(f == -1 ? g : f)};",
            "",
            "\t// 5. FIdentity (操作の単位元)",
            "\t//    役割: 「何もしない」を表す操作の値。",
            "\t//    タイミング: 遅延配列の初期化や、操作がないことの判定に使われる。",
            "\t//    例: 加算なら 0, 更新なら -1 や long.MinValue などのあり得ない値",
            "\tpublic ${3:long} FIdentity => ${8:-1};",
            "}",
            "",
            "// ★ Mainメソッド内での定義例:",
            "// var seg = new LazySegtree<${2:long}, ${3:long}, ${1:MyOp}>(${9:N});"
        ],
        "description": "ACL LazySegtree Struct Template (Detailed Comments)"
    },

    "ACL LazySegtree RUQ/RMQ (Detailed)": {
        "prefix": "acl_lazy_ruq_detailed",
        "body": [
            "// 【区間更新(RUQ) & 区間最大値(RMQ)】",
            "// S:long (値), F:long (更新値, IDなら更新なし)",
            "struct ${1:RangeUpdateMax} : ILazySegtreeOperator<long, long>",
            "{",
            "\t// 更新操作がないことを表す値 (データとしてあり得ない値にする)",
            "\tconst long ID = ${2:long.MinValue};",
            "",
            "\t// [データ] 最大値を維持したいので Max",
            "\tpublic long Operate(long x, long y) => Math.Max(x, y);",
            "\t// [データ] Maxの単位元は無限小",
            "\tpublic long Identity => long.MinValue;",
            "",
            "\t// [適用] fがID(更新なし)でなければ、値をfに塗り替える",
            "\tpublic long Mapping(long f, long x) => (f == ID ? x : f);",
            "",
            "\t// [合成] 新しい操作fが有効なら、古い操作gを捨ててfを上書きする",
            "\tpublic long Composition(long f, long g) => (f == ID ? g : f);",
            "",
            "\t// [操作] 何もしない操作",
            "\tpublic long FIdentity => ID;",
            "}",
            "// var seg = new LazySegtree<long, long, ${1:RangeUpdateMax}>(${3:N});"
        ],
        "description": "ACL LazySegtree Struct for RUQ & RMQ with comments"
    },
	"Next Permutation": {
	"prefix": "nextperm",
	"body": [
		"public static bool NextPermutation<T>(Span<T> array) where T : IComparable<T>",
		"{",
		"    int i = array.Length - 2;",
		"    while (i >= 0 && array[i].CompareTo(array[i + 1]) >= 0) i--;",
		"    if (i < 0) return false;",
		"    int j = array.Length - 1;",
		"    while (array[j].CompareTo(array[i]) <= 0) j--;",
		"    (array[i], array[j]) = (array[j], array[i]);",
		"    array.Slice(i + 1).Reverse();",
		"    return true;",
		"}"
	],
	"description": "次の順列を生成するメソッド (NextPermutation)"
	},
	"GCD and LCM": {
		"prefix": "gcd",
		"body": [
			"/// <summary>",
			"/// 最大公約数 (Greatest Common Divisor)",
			"/// </summary>",
			"static long Gcd(long a, long b)",
			"{",
			"    while (b != 0) (a, b) = (b, a % b);",
			"    return a;",
			"}",
			"",
			"/// <summary>",
			"/// 最小公倍数 (Least Common Multiple)",
			"/// </summary>",
			"static long Lcm(long a, long b)",
			"{",
			"    if (a == 0 || b == 0) return 0;",
			"    return (a / Gcd(a, b)) * b;",
			"}"
		],
		"description": "最大公約数(Gcd)と最小公倍数(Lcm)の関数定義を展開します"
	},
